<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TarkovTacticalMap</AssemblyName>
    <RootNamespace>TarkovTacticalMap.App</RootNamespace>
    <ApplicationIcon />
    <Platforms>AnyCPU;x64</Platforms>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>

    <!-- 版本号：发布 Release 时用 tag（vX.Y.Z）覆盖，见 .github/workflows/release.yml -->
    <Version>2.2.0</Version>
    <Product>塔塔战术平板</Product>
    <Company>Tarkov Tactical Map</Company>
    <Description>小队内部使用的战术地图白板（TCP 房主权威同步）</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp.Views.WPF" Version="2.88.8" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="2.88.8" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TarkovTacticalMap.Core\TarkovTacticalMap.Core.csproj" />
    <ProjectReference Include="..\TarkovTacticalMap.Network\TarkovTacticalMap.Network.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Icons\*.svg" />
  </ItemGroup>

</Project>
