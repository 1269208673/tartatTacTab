<Window x:Class="TarkovTacticalMap.App.Views.GridSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="网格行列数" Height="220" Width="340"
        Background="{StaticResource WindowBg}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="网格仅作为视觉参考，标记坐标始终使用归一化值存储。" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondary}" />
        <Grid Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="列数：" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" x:Name="ColsBox" Margin="4,0,12,0" />
            <TextBlock Grid.Column="2" Text="行数：" VerticalAlignment="Center" />
            <TextBox Grid.Column="3" x:Name="RowsBox" Margin="4,0,0,0" />
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="取消" Width="80" Click="OnCancelClick" />
            <Button Content="确定" Width="80" Click="OnOkClick" />
        </StackPanel>
    </StackPanel>
</Window>
