<Window x:Class="TarkovTacticalMap.App.Views.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入文本" Height="220" Width="420"
        Background="{StaticResource WindowBg}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        KeyDown="OnKeyDown">
    <StackPanel Margin="16">
        <TextBlock x:Name="PromptText" Text="请输入内容：" TextWrapping="Wrap" />
        <TextBox x:Name="InputBox" Margin="0,8" Height="72" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="取消" Width="80" Click="OnCancelClick" />
            <Button Content="确定" Width="80" Click="OnOkClick" />
        </StackPanel>
    </StackPanel>
</Window>
