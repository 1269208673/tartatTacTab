<Window x:Class="TarkovTacticalMap.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="塔塔战术平板" Height="840" Width="1380"
        Background="{StaticResource WindowBg}"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        Closing="OnWindowClosing">

    <DockPanel>

        <!-- 菜单栏 -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="文件(_F)">
                <MenuItem Header="新建房间…" Click="OnNewRoomClick" />
                <MenuItem Header="加入房间…" Click="OnJoinRoomClick" />
                <Separator />
                <MenuItem Header="上传地图图片…" Click="OnUploadImageClick" />
                <MenuItem Header="清空缓存" Click="OnClearCacheClick" />
                <Separator />
                <MenuItem Header="退出" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="房间(_R)">
                <MenuItem Header="玩家列表…" Click="OnPlayerListClick" />
                <MenuItem Header="断开连接" Click="OnDisconnectClick" />
            </MenuItem>
            <MenuItem Header="视图(_V)">
                <MenuItem Header="显示网格" IsCheckable="True" IsChecked="{Binding IsGridVisible, Mode=OneWay}"
                          Click="OnToggleGridClick" />
                <MenuItem Header="设置网格行列数…" Click="OnGridSettingsClick" />
                <MenuItem Header="重置视图" Click="OnResetViewClick" />
            </MenuItem>
            <MenuItem Header="帮助(_H)">
                <MenuItem Header="关于" Click="OnAboutClick" />
            </MenuItem>
        </Menu>

        <!-- 状态栏 -->
        <StatusBar DockPanel.Dock="Bottom" Height="26">
            <StatusBarItem>
                <TextBlock Text="{Binding ConnectionText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="网格 " Foreground="{StaticResource TextSecondary}" />
                    <TextBlock Text="{Binding GridLabel}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" />
                </StackPanel>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="在线 " Foreground="{StaticResource TextSecondary}" />
                    <TextBlock Text="{Binding PlayerSummary}" MaxWidth="320" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding CoordinateText}" Foreground="{StaticResource TextSecondary}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondary}"
                           MaxWidth="460" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 左侧工具栏 -->
            <Border Grid.Column="0" Width="152" Background="{StaticResource PanelBg}"
                    BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="4,6">
                        <ItemsControl ItemsSource="{Binding Tools}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Style="{StaticResource ToolButtonStyle}"
                                                  IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                  Tag="{Binding Kind}"
                                                  Click="OnToolButtonClick"
                                                  ToolTip="{Binding Label}">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Grid Height="22">
                                                <Image Width="22" Height="22"
                                                       Source="{Binding IconId, Converter={StaticResource IconConverter}}" />
                                            </Grid>
                                            <TextBlock Text="{Binding Label}" FontSize="11" HorizontalAlignment="Center"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Margin="2,8" Background="{StaticResource BorderSoft}" />

                        <TextBlock Text="颜色" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding Swatches}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="26" Height="26" Margin="2" Padding="0"
                                            ToolTip="{Binding}"
                                            Tag="{Binding}"
                                            Click="OnSwatchClick"
                                            Background="{Binding Converter={StaticResource ColorBrushConverter}}"
                                            BorderBrush="#88FFFFFF" BorderThickness="1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBox Text="{Binding CurrentColor, UpdateSourceTrigger=LostFocus}" Margin="2,4" />

                        <TextBlock Text="大小（相对图宽）" Style="{StaticResource SectionTitle}" />
                        <Slider Minimum="0.002" Maximum="0.4" Value="{Binding CurrentSize}"
                                SmallChange="0.002" LargeChange="0.01" Margin="4,0" />
                        <TextBlock Text="{Binding CurrentSize, StringFormat={}{0:F3}}"
                                   Foreground="{StaticResource TextSecondary}" Margin="4,0,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 画布 -->
            <Border Grid.Column="1" Background="#101216">
                <Grid>
                    <skia:SKElement x:Name="CanvasView"
                                    PaintSurface="OnPaintSurface"
                                    MouseDown="OnCanvasMouseDown"
                                    MouseUp="OnCanvasMouseUp"
                                    MouseMove="OnCanvasMouseMove"
                                    MouseWheel="OnCanvasMouseWheel"
                                    MouseLeave="OnCanvasMouseLeave"
                                    Focusable="True" />
                    <TextBlock Text="{Binding MapTitle}" HorizontalAlignment="Left" VerticalAlignment="Top"
                               Margin="10,8" Foreground="#66E6E8EB" IsHitTestVisible="False" />
                </Grid>
            </Border>

            <!-- 右侧属性面板 -->
            <Border Grid.Column="2" Width="268" Background="{StaticResource PanelBg}"
                    BorderBrush="{StaticResource BorderSoft}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,8">
                        <TextBlock Text="属性面板" FontWeight="Bold" FontSize="13" />
                        <TextBlock Text="选中画布上的标记后可编辑" Style="{StaticResource SectionTitle}" />

                        <Border Style="{StaticResource CardBorder}" Margin="0,6" Padding="10"
                                Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectionTypeText}" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="创建者：仅可编辑自己的标记" Style="{StaticResource SectionTitle}" />

                                <TextBlock Text="颜色（#RRGGBB / #AARRGGBB）" Style="{StaticResource SectionTitle}" />
                                <TextBox Text="{Binding SelectionColorText, UpdateSourceTrigger=LostFocus}"
                                         IsEnabled="{Binding CanEditSelection}" />

                                <TextBlock Text="大小 / 线宽" Style="{StaticResource SectionTitle}" />
                                <Slider Minimum="0.001" Maximum="0.5" Value="{Binding SelectionSize}"
                                        IsEnabled="{Binding CanEditSelection}" />
                                <TextBlock Text="{Binding SelectionSize, StringFormat={}{0:F4}}"
                                           Foreground="{StaticResource TextSecondary}" />

                                <TextBlock Text="旋转（度）" Style="{StaticResource SectionTitle}" />
                                <Slider Minimum="0" Maximum="360" Value="{Binding SelectionRotation}"
                                        IsEnabled="{Binding CanEditSelection}" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="-15°" Click="OnRotateMinusClick" IsEnabled="{Binding CanEditSelection}" />
                                    <Button Content="+15°" Click="OnRotatePlusClick" IsEnabled="{Binding CanEditSelection}" />
                                    <TextBlock Text="{Binding SelectionRotation, StringFormat={}{0:F1}°}"
                                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Text="文本内容（仅文本标记）" Style="{StaticResource SectionTitle}" />
                                <TextBox Text="{Binding SelectionText, UpdateSourceTrigger=LostFocus}"
                                         AcceptsReturn="True" Height="56" TextWrapping="Wrap"
                                         IsEnabled="{Binding CanEditSelection}" />

                                <Button Content="删除标记" Margin="0,10,0,0" Click="OnDeleteSelectedClick"
                                        IsEnabled="{Binding CanEditSelection}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,6" Padding="10"
                                Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Text="未选中标记。左键点击画布上的标记可选中，点击空白处取消选中。"
                                       TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" />
                        </Border>

                        <TextBlock Text="本机地址（供队友输入）" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding HostAddressText}" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondary}" />

                        <TextBlock Text="快捷键" Style="{StaticResource SectionTitle}" />
                        <TextBlock Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"
                                   Text="滚轮：缩放 / 中键或空格+左键：平移 / Delete：删除选中 / Esc：取消选中 / Ctrl+0：重置视图" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
