<Window x:Class="TarkovTacticalMap.App.Views.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="塔塔战术平板 · 进入房间" Height="640" Width="880"
        Background="{StaticResource WindowBg}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="塔塔战术平板" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
            <TextBlock Text="小队内部使用的战术地图白板：手动上传地图，放置语义图标 / 文本 / 箭头 / 圆圈 / 方框，通过 TCP 在房主与队友之间同步。"
                       TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" />
            <TextBlock Text="队友之间请先用 ZeroTier / Tailscale / Radmin VPN 等工具组网，然后输入房主的虚拟局域网 IP。"
                       TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="2" Margin="0,4">
            <!-- 创建房间 -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="创建房间（房主）" FontSize="15" FontWeight="Bold" />
                    <TextBlock Text="本机将成为权威服务端，队友用你的 IP + 端口 + 口令加入。"
                               TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,8" />

                    <TextBlock Text="玩家名" Style="{StaticResource SectionTitle}" />
                    <TextBox x:Name="HostNameBox" />

                    <TextBlock Text="监听端口（默认 27015）" Style="{StaticResource SectionTitle}" />
                    <TextBox x:Name="HostPortBox" />

                    <TextBlock Text="房间口令（可留空）" Style="{StaticResource SectionTitle}" />
                    <PasswordBox x:Name="HostPasswordBox" />

                    <TextBlock Text="地图图片" Style="{StaticResource SectionTitle}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="选择图片…" Click="OnPickHostImageClick" />
                        <Button Content="使用空白网格" Click="OnUseBlankImageClick" />
                    </StackPanel>
                    <TextBlock x:Name="HostImageText" Text="未选择（将使用空白网格）" Foreground="{StaticResource TextSecondary}"
                               TextTrimming="CharacterEllipsis" Margin="2,2,0,0" />

                    <TextBlock Text="网格列 / 行（默认 8 / 6）" Style="{StaticResource SectionTitle}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="HostColsBox" Width="60" />
                        <TextBlock Text=" × " VerticalAlignment="Center" />
                        <TextBox x:Name="HostRowsBox" Width="60" />
                    </StackPanel>

                    <Button Content="创建房间" Margin="0,14,0,0" Height="32" Click="OnCreateRoomClick"
                            Background="#1F3A4A" BorderBrush="{StaticResource AccentBrush}" />

                    <TextBlock Text="本机可用地址（队友填这个 IP）" Style="{StaticResource SectionTitle}" />
                    <Border Background="{StaticResource PanelBg2}" CornerRadius="4" Padding="8">
                        <TextBlock x:Name="HostAddressText" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- 加入房间 -->
            <Border Style="{StaticResource CardBorder}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="加入房间（客户端）" FontSize="15" FontWeight="Bold" />
                    <TextBlock Text="输入房主的虚拟局域网 IP、端口与口令。"
                               TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,8" />

                    <TextBlock Text="玩家名" Style="{StaticResource SectionTitle}" />
                    <TextBox x:Name="JoinNameBox" />

                    <TextBlock Text="房主 IP" Style="{StaticResource SectionTitle}" />
                    <TextBox x:Name="JoinHostBox" />

                    <TextBlock Text="端口（默认 27015）" Style="{StaticResource SectionTitle}" />
                    <TextBox x:Name="JoinPortBox" />

                    <TextBlock Text="房间口令" Style="{StaticResource SectionTitle}" />
                    <PasswordBox x:Name="JoinPasswordBox" />

                    <Button Content="加入房间" Margin="0,14,0,0" Height="32" Click="OnJoinRoomClick"
                            Background="#1F3A4A" BorderBrush="{StaticResource AccentBrush}" />

                    <TextBlock Text="连接说明" Style="{StaticResource SectionTitle}" />
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"
                               Text="· 首次监听端口时 Windows 会弹防火墙提示，房主需允许 TCP 入站。&#x0a;· 口令错误或客户端版本不一致会被房主拒绝。&#x0a;· 地图图片只需传输一次，之后命中本地缓存。" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" Text="" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                <Button x:Name="LocalModeButton" Content="仅本机模式（不联网）" Click="OnLocalModeClick" />
                <Button Content="退出" Width="90" Click="OnExitClick" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
