<Window x:Class="TarkovTacticalMap.App.Views.PlayerListDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="房间 / 玩家" Height="420" Width="460"
        Background="{StaticResource WindowBg}"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">
        <TextBlock Text="房间状态" Style="{StaticResource SectionTitle}" />
        <TextBlock x:Name="ModeText" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" />

        <TextBlock Text="在线玩家" Style="{StaticResource SectionTitle}" />
        <Border Style="{StaticResource CardBorder}" Padding="10">
            <TextBlock x:Name="PlayerText" TextWrapping="Wrap" />
        </Border>

        <TextBlock Text="本机地址（供队友填写）" Style="{StaticResource SectionTitle}" />
        <Border Style="{StaticResource CardBorder}" Padding="10">
            <TextBlock x:Name="HostAddressText" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" />
        </Border>

        <TextBlock Text="提示：首次监听端口时 Windows 可能弹出防火墙询问，请允许 TCP 入站，或手动放行程序。"
                   TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}" Margin="0,10,0,0" />

        <Button Content="关闭" Width="90" HorizontalAlignment="Right" Margin="0,14,0,0" Click="OnCloseClick" />
    </StackPanel>
</Window>
